# Service Account JSON (Drive integration) — set via Firebase CLI:
#   firebase functions:secrets:set DRIVE_SA
# Paste the full JSON when prompted. Never commit the JSON here.
#
# Optional fallback env (Functions runtime):
# DRIVE_SA=

# Root Drive folder ID — recommended to set it via UI in Settings ▸ Drive,
# which is stored in Firestore settings/main. This env is a fallback only.
# DRIVE_ROOT_FOLDER_ID=

# Set this if running the seed script locally with the Admin SDK:
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json