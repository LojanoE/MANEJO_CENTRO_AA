rules_version = '2';

// ⚠️ MODO PILOTO — REGLAS PERMISIVAS
// Cualquier usuario autenticado puede leer/escribir cualquier objeto.
// NO usar en producción real. En producción, restringir por usuario/rol.

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
