rules_version = '2';

// ⚠️ MODO PILOTO — REGLAS PERMISIVAS
// Cualquier usuario autenticado puede leer/escribir cualquier documento.
// NO usar en producción real. En producción, volver a las reglas por rol
// que estaban antes de este commit.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
